#!/usr/bin/env bash
# Fleet control from the workstation. Nodes and their SSH aliases come from inventory.json.
#
#   fleet sync  <node|all>    update the node: git pull if its fleet_dir is a clone, else copy (no deletes, no secrets)
#   fleet apply <node|all>    sync, then apply roles: edge (Caddy/DNS/mDNS/portal), agent, tailnet exposure
#   fleet stacks <node> <args>  run stacks/stacks.sh on a node (e.g. fleet stacks devbox status)
#   fleet status              machines, containers and service health via the portal API
#   fleet render              render edge config into build/edge for review
set -euo pipefail

FLEET_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INV="$FLEET_DIR/scripts/inv.py"
inv() { python3 "$INV" "$@"; }

nodes_for() { if [[ "${1:-}" == all ]]; then inv nodes; else inv get "nodes.$1.ssh" >/dev/null && echo "$1"; fi; }
edge_node() {
  local n
  for n in $(inv nodes); do
    if [[ "$(inv get "nodes.$n.edge" 2>/dev/null || true)" == True ]]; then echo "$n"; fi
  done
}

sync_node() {
  local n="$1" ssh dir
  ssh="$(inv get "nodes.$n.ssh")"; dir="$(inv get "nodes.$n.fleet_dir")"
  if ssh "$ssh" "test -d '$dir/.git'"; then
    pull_node "$n" "$ssh" "$dir"
  else
    copy_node "$n" "$ssh" "$dir"
  fi
}

# Git clone on the node: deploy what is pushed, never uncommitted workstation edits.
pull_node() {
  local n="$1" ssh="$2" dir="$3" head
  head="$(git -C "$FLEET_DIR" rev-parse HEAD)"
  if ! git -C "$FLEET_DIR" diff --quiet HEAD 2>/dev/null; then
    echo "!! $n pulls from GitHub: uncommitted changes here will not be deployed" >&2
  fi
  git -C "$FLEET_DIR" fetch -q origin 2>/dev/null || true
  if ! git -C "$FLEET_DIR" merge-base --is-ancestor "$head" origin/main 2>/dev/null; then
    echo "!! $n pulls from GitHub: push $(git -C "$FLEET_DIR" rev-parse --short HEAD) first (git push)" >&2
    return 1
  fi
  echo "==> pull $n ($ssh:$dir)"
  ssh "$ssh" "cd '$dir' && git pull -q --ff-only && git log --oneline -1"
}

# Runtime copy (no .git on the node): rsync without deletes; secrets and private files are never sent.
copy_node() {
  local n="$1" ssh="$2" dir="$3" stack
  local -a skip=()
  # Only the stacks inventory.json assigns to this node are copied.
  for stack in $(cd "$FLEET_DIR/stacks" && ls -d */ | tr -d /); do
    [[ -f "$FLEET_DIR/stacks/$stack/compose.yaml" ]] || continue
    inv stacks "$n" | grep -qx "$stack" || skip+=(--exclude "/stacks/$stack/")
  done
  echo "==> copy $n ($ssh:$dir)"
  ssh "$ssh" "mkdir -p '$dir'"
  rsync -rlptz \
    --exclude .git --exclude /build --exclude .DS_Store --exclude __pycache__ \
    --include .env.example --exclude .env --exclude '.env.*' --exclude '*.env' \
    --exclude 'data/' --exclude 'config/' --exclude 'library/' \
    ${skip[@]+"${skip[@]}"} \
    "$FLEET_DIR/" "$ssh:$dir/"
  ssh "$ssh" "printf '%s\n' '$(git -C "$FLEET_DIR" rev-parse --short HEAD 2>/dev/null || echo uncommitted)$(git -C "$FLEET_DIR" diff --quiet 2>/dev/null || echo '+dirty')' > '$dir/.deployed-revision'"
}

apply_node() {
  local n="$1" ssh dir
  ssh="$(inv get "nodes.$n.ssh")"; dir="$(inv get "nodes.$n.fleet_dir")"
  sync_node "$n"
  if [[ "$n" == "$(edge_node)" ]]; then
    echo "==> [$n] edge role"; ssh "$ssh" "FLEET_NODE=$n '$dir/edge/setup-edge.sh'"
  fi
  echo "==> [$n] agent"; ssh "$ssh" "FLEET_NODE=$n '$dir/agent/install-agent.sh'"
  echo "==> [$n] tailnet exposure"; ssh "$ssh" "FLEET_NODE=$n '$dir/scripts/expose-tailnet.sh'"
}

status() {
  local edge ssh
  edge="$(edge_node)"; ssh="$(inv get "nodes.$edge.ssh")"
  for n in $(inv nodes); do
    echo "== $n"
    ssh "$ssh" "curl -fsS -m 8 http://127.0.0.1/api/nodes/$n/system" 2>/dev/null | python3 -c '
import json, sys
d = json.load(sys.stdin)
m, c, k = d["memory"], d["cpu"], d["disk"]
gb = lambda b: "%.1fG" % (b / 2**30)
print("  %s  cpu %s%%  load %s  mem %s/%s  disk %s%%  up %dh" % (d["hostname"], c["percent"], " ".join(map(str, c["load"])), gb(m["used"]), gb(m["total"]), k["percent"], (d["uptime_seconds"] or 0) // 3600))
for x in d["containers"]:
    print("  [ctr] %-34s %s" % (x["name"], x["status"]))
for sid, s in d["services"].items():
    print("  [svc] %-12s %s" % (sid, s["status"]))
' || echo "  agent unreachable"
  done
}

cmd="${1:-}"; shift || true
case "$cmd" in
  sync) for n in $(nodes_for "${1:?node|all}"); do sync_node "$n"; done ;;
  apply) for n in $(nodes_for "${1:?node|all}"); do apply_node "$n"; done ;;
  stacks) n="${1:?node}"; shift; ssh "$(inv get "nodes.$n.ssh")" "'$(inv get "nodes.$n.fleet_dir")/stacks/stacks.sh' $*" ;;
  status) status ;;
  render) python3 "$FLEET_DIR/edge/render.py" ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
